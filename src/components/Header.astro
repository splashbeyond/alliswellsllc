---
import { client } from '../client.config';
const navLinks = [
  { label: 'Services', href: '/services' },
  { label: 'About', href: '/about' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'Contact', href: '/contact' },
];
const currentPath = Astro.url.pathname;
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-dark/80 backdrop-blur-sm border-b border-dark-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">

      <!-- Logo -->
      <a href="/" class="flex items-center group">
        <img src="/logo.png" alt="All Is Wells LLC" class="h-10 lg:h-12 w-auto object-contain" />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-8">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`text-sm font-medium tracking-wide transition-colors hover:text-electric ${currentPath === link.href ? 'text-electric' : 'text-neutral-300'}`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Desktop right: phone + CTA -->
      <div class="hidden lg:flex items-center gap-4">
        <a href={`tel:${client.phone.replace(/\D/g,'')}`} class="text-sm font-medium text-neutral-300 hover:text-electric transition-colors">
          <svg class="text-electric inline-block mr-1 -mt-0.5" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>{client.phone}
        </a>
        <a href="/contact" class="btn-electric bg-electric text-dark font-barlow font-black text-sm tracking-widest uppercase px-5 py-2.5 rounded">
          Free Estimate
        </a>
      </div>

      <!-- Mobile: phone icon + hamburger -->
      <div class="flex items-center gap-3 lg:hidden">
        <a href={`tel:${client.phone.replace(/\D/g,'')}`} class="text-electric" aria-label="Call us">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.23 19.79 19.79 0 0 1 1.61 4.7 2 2 0 0 1 3.6 2.5h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.1a16 16 0 0 0 6 6l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.5 17.5v-.58Z"/>
          </svg>
        </a>
        <button id="menu-btn" aria-label="Toggle menu" class="text-white p-1">
          <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/>
          </svg>
          <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-dark-surface border-t border-dark-border">
    <nav class="flex flex-col px-4 py-4 gap-1">
      {navLinks.map(link => (
        <a href={link.href} class="py-3 px-2 text-neutral-300 hover:text-electric font-medium border-b border-dark-border last:border-0 transition-colors">
          {link.label}
        </a>
      ))}
      <a href="/contact" class="mt-3 btn-electric bg-electric text-dark font-barlow font-black text-sm tracking-widest uppercase px-5 py-3 rounded text-center">
        Free Estimate
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
  });

  // Solid background on scroll
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) {
      header?.classList.add('bg-dark', 'shadow-lg');
      header?.classList.remove('bg-dark/80', 'backdrop-blur-sm');
    } else {
      header?.classList.remove('bg-dark', 'shadow-lg');
      header?.classList.add('bg-dark/80', 'backdrop-blur-sm');
    }
  }, { passive: true });
</script>
