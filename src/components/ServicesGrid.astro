---
import { client } from '../client.config';

const icons: Record<string, string> = {
  zap: `<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>`,
  plug: `<path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8H6a2 2 0 0 0-2 2v2a7 7 0 0 0 14 0v-2a2 2 0 0 0-2-2Z"/>`,
  home: `<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
  building: `<rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/><path d="M12 10h.01"/><path d="M12 14h.01"/><path d="M16 10h.01"/><path d="M16 14h.01"/><path d="M8 10h.01"/><path d="M8 14h.01"/>`,
  settings: `<circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>`,
  sun: `<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>`,
  wind: `<path d="M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2"/><path d="M9.6 4.6A2 2 0 1 1 11 8H2"/><path d="M12.6 19.4A2 2 0 1 0 14 16H2"/>`,
  'alert-triangle': `<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>`,
};

interface Props { preview?: boolean; }
const { preview = false } = Astro.props;
const services = preview ? client.services.slice(0, 6) : client.services;
---

<section class="bg-dark py-24 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="scroll-reveal mb-16">
      <p class="font-barlow font-bold text-electric text-sm tracking-[0.3em] uppercase mb-3">What We Do</p>
      <h2 class="font-barlow font-black text-white" style="font-size: clamp(2.5rem, 5vw, 4rem); line-height:1.05; letter-spacing:-0.02em;">
        Electrical Services<br/>Done Right.
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {services.map((service, i) => (
        <div class={`scroll-reveal service-card bg-dark-surface border border-dark-border border-l-4 border-l-dark-border rounded-xl p-7 group`}
             style={`transition-delay: ${i * 60}ms`}>
          <div class="w-11 h-11 rounded-lg bg-dark flex items-center justify-center mb-5 group-hover:bg-electric/10 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
              stroke="#FFD600" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              set:html={icons[service.icon] ?? icons.zap} />
          </div>
          <h3 class="font-barlow font-black text-white text-xl mb-2">{service.name}</h3>
          <p class="text-neutral-500 text-sm leading-relaxed">{service.description}</p>
        </div>
      ))}
    </div>

    {preview && (
      <div class="text-center mt-12">
        <a href="/services" class="btn-electric inline-block bg-electric text-dark font-barlow font-black text-sm tracking-widest uppercase px-8 py-4 rounded">
          View All Services →
        </a>
      </div>
    )}
  </div>
</section>
