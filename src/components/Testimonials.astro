---
import { client } from '../client.config';

const StarSVG = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`;
const StarSmSVG = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`;
---

<section class="bg-dark-surface py-24 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="scroll-reveal text-center mb-16">
      <p class="font-barlow font-bold text-electric text-sm tracking-[0.3em] uppercase mb-3">Reviews</p>
      <h2 class="font-barlow font-black text-white" style="font-size: clamp(2.5rem, 5vw, 4rem); line-height:1.05; letter-spacing:-0.02em;">
        What Customers Say.
      </h2>
      <div class="flex items-center justify-center gap-1.5 mt-5">
        {Array.from({length: 5}).map(() => (
          <span class="text-electric" set:html={StarSVG} />
        ))}
        <span class="text-neutral-400 text-sm ml-2">{client.ratingLabel}</span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {client.testimonials.map((t, i) => (
        <div class="scroll-reveal bg-dark border border-dark-border rounded-2xl p-8 flex flex-col" style={`transition-delay: ${i * 80}ms`}>
          <p class="font-barlow font-black text-electric text-5xl leading-none mb-4 select-none">"</p>
          <p class="text-neutral-300 text-sm leading-relaxed flex-1 mb-6 italic">"{t.quote}"</p>
          <div class="border-t border-dark-border pt-4 flex items-center justify-between">
            <div>
              <p class="font-semibold text-white text-sm">{t.name}</p>
              <p class="text-neutral-600 text-xs">{t.verified}</p>
            </div>
            <div class="flex gap-0.5 text-electric">
              {Array.from({length: t.rating}).map(() => (
                <span set:html={StarSmSVG} />
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="scroll-reveal text-center mt-10">
      <a href={client.social.google} target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-2 text-sm text-neutral-400 hover:text-electric transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        View all reviews on Google
      </a>
    </div>
  </div>
</section>
