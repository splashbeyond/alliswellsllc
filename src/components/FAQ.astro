---
import { client } from '../client.config';
---

<section class="bg-dark py-24 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="scroll-reveal text-center mb-16">
      <p class="font-barlow font-bold text-electric text-sm tracking-[0.3em] uppercase mb-3">FAQ</p>
      <h2 class="font-barlow font-black text-white" style="font-size: clamp(2.5rem, 5vw, 4rem); line-height:1.05; letter-spacing:-0.02em;">
        Common Questions.
      </h2>
    </div>

    <div class="space-y-3">
      {client.faqs.map((faq, i) => (
        <details class="scroll-reveal group bg-dark-surface border border-dark-border rounded-xl overflow-hidden" style={`transition-delay: ${i * 60}ms`}>
          <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none hover:bg-dark-hover transition-colors">
            <span class="font-semibold text-white text-sm sm:text-base">{faq.q}</span>
            <span class="text-electric font-barlow font-black text-xl flex-shrink-0 group-open:rotate-45 transition-transform duration-200">+</span>
          </summary>
          <div class="px-6 pb-5">
            <p class="text-neutral-400 text-sm leading-relaxed">{faq.a}</p>
          </div>
        </details>
      ))}
    </div>

    <div class="scroll-reveal text-center mt-12">
      <p class="text-neutral-500 text-sm mb-4">Still have questions?</p>
      <a href="/contact" class="btn-electric inline-block bg-electric text-dark font-barlow font-black text-sm tracking-widest uppercase px-8 py-4 rounded">
        Contact Us
      </a>
    </div>
  </div>
</section>
