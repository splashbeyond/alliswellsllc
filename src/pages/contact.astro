---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import LeadForm from '../components/LeadForm.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import Footer from '../components/Footer.astro';
import { client } from '../client.config';
---

<Layout title={`Contact & Free Estimate — ${client.name}`} description="Get a free electrical estimate from All Is Wells LLC in Surprise, AZ. Call (480) 628-9310 or fill out our online form.">
  <Header />

  <!-- Page hero -->
  <section class="bg-dark pt-32 pb-16 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div>
          <p class="animate-slide-up font-barlow font-bold text-electric text-sm tracking-[0.3em] uppercase mb-3">Get In Touch</p>
          <h1 class="animate-slide-up delay-100 font-barlow font-black text-white mb-4" style="font-size: clamp(3rem, 7vw, 6rem); line-height:0.95; letter-spacing:-0.02em;">
            Let's Talk.
          </h1>
          <p class="animate-slide-up delay-200 text-neutral-400 text-lg max-w-md mb-10">
            Free estimates, honest pricing, and work done right. Reach out and Aaron will personally get back to you within 2 hours.
          </p>

          <div class="space-y-5">
            <a href={`tel:${client.phone.replace(/\D/g,'')}`} class="flex items-center gap-4 group">
              <div class="w-12 h-12 bg-electric rounded-lg flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0A0A0A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.23 19.79 19.79 0 0 1 1.61 4.7 2 2 0 0 1 3.6 2.5h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 10.1a16 16 0 0 0 6 6l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.5 17.5v-.58Z"/>
                </svg>
              </div>
              <div>
                <p class="font-barlow font-black text-white text-xl group-hover:text-electric transition-colors">{client.phone}</p>
                <p class="text-neutral-500 text-xs">{client.hours.weekday}</p>
              </div>
            </a>

            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-dark-surface border border-dark-border rounded-lg flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFD600" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                </svg>
              </div>
              <div>
                <p class="font-medium text-white text-sm">{client.email}</p>
                <p class="text-neutral-500 text-xs">We reply within 4 hours</p>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-dark-surface border border-dark-border rounded-lg flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFD600" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <div>
                <p class="font-medium text-white text-sm">{client.address.street}, {client.address.city}, {client.address.state}</p>
                <p class="text-neutral-500 text-xs">Serving the entire West Valley</p>
              </div>
            </div>

            <div class="mt-4 p-4 bg-ember/10 border border-ember/30 rounded-xl">
              <p class="text-ember font-barlow font-black text-sm tracking-wide uppercase mb-1 flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                24/7 Emergency Line
              </p>
              <a href={`tel:${client.emergencyPhone.replace(/\D/g,'')}`} class="font-barlow font-black text-white text-2xl hover:text-ember transition-colors">
                {client.emergencyPhone}
              </a>
            </div>
          </div>
        </div>

        <!-- Quick contact card -->
        <div class="animate-slide-up delay-200 bg-dark-surface border border-dark-border rounded-2xl p-8">
          <p class="font-barlow font-black text-white text-2xl mb-1">Request a Free Estimate</p>
          <p class="text-neutral-500 text-sm mb-6">Aaron will call you back within 2 hours.</p>
          <form action={client.formAction} method="POST" class="space-y-4">
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1.5">Name *</label>
                <input name="name" type="text" required placeholder="Your name"
                  class="w-full bg-dark border border-dark-border text-white placeholder-neutral-600 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-electric transition-colors" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1.5">Phone *</label>
                <input name="phone" type="tel" required placeholder="(480) 555-0000"
                  class="w-full bg-dark border border-dark-border text-white placeholder-neutral-600 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-electric transition-colors" />
              </div>
            </div>
            <div>
              <label class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1.5">Service Needed</label>
              <select name="service" class="w-full bg-dark border border-dark-border text-white rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-electric transition-colors appearance-none">
                <option>Panel Upgrade</option>
                <option>EV Charger Installation</option>
                <option>Residential Wiring</option>
                <option>Commercial Electrical</option>
                <option>Emergency Service</option>
                <option>Other</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1.5">Message</label>
              <textarea name="message" rows="3" placeholder="Tell us about your project..."
                class="w-full bg-dark border border-dark-border text-white placeholder-neutral-600 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-electric transition-colors resize-none"></textarea>
            </div>
            <button type="submit" class="btn-electric w-full bg-electric text-dark font-barlow font-black text-sm tracking-widest uppercase px-6 py-4 rounded-lg">
              Send Request →
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <ServiceAreas />
  <Footer />
</Layout>
